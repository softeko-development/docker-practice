# Server-side only: used by server components. Read at run time.
# In Docker this is the compose service name (http://api:4000/api).
API_URL=http://localhost:4000/api

# Browser-side: used by client components (the create-user modal).
# Inlined into the JS bundle at BUILD time. Must be reachable from the user's browser.
NEXT_PUBLIC_API_URL=http://localhost:4000/api
